# Parses Markdown as it streams in, an LLM reply delta by delta, into top-level blocks: each
# finished block reaches the listener once, final, and the unfinished tail is parsed again on
# every delta. Blocks are kramdown trees, so any kramdown converter renders them.
# 
#   class HtmlView
#     include StreamingMarkdownParser::Listener
# 
#     def initialize
#       @done = +''
#       @tail = ''
#     end
# 
#     def on_block(root) = @done << Kramdown::Converter::Html.convert(root).first
#     def on_open(root) = @tail = Kramdown::Converter::Html.convert(root).first
#     def to_html = @done + @tail
#   end
# 
#   parser = StreamingMarkdownParser.new(view = HtmlView.new)
#   parser.append("Hello.\n\nWor")   # on_open: "Hello.", "Wor" (the next line may continue "Hello.")
#   parser.append("ld.\n")           # on_block: "Hello.", as "World." began a new block
#                                    # on_open: "World."
#   parser.finish                    # on_block: "World."; on_open: empty
#   view.to_html                     # => "<p>Hello.</p>\n<p>World.</p>\n"
# 
# A listener that wants only final output implements {Listener#on_block} alone.
# 
# == Implementation details
# 
# A cut between two blocks is taken only where kramdown agrees: once the first line after a
# blank line (or after a closer) is complete, the open text before it is parsed alone, the line
# alone, and both together, and the cut stands only if the blocks come out the same. So a loose
# list's next item, an indented continuation or a definition keeps the block open, with no
# Markdown rules written here.
# 
# Inside an unclosed fence, `$$` math block, HTML comment or `{::comment}`-style extension there
# is no cut at all: kramdown reads paragraphs until the closer comes, and the closer would undo
# the cut. Whether a `$$`, `<!--` or extension line opens one, kramdown judges too, as a fence
# missed inside a block wrongly held open is a cut inside that fence.
# 
# Per delta, the cost is one parse of the open tail, plus one check per candidate cut.
class StreamingMarkdownParser
  DEFAULT_OPTIONS: ::Hash[Symbol, Object]
  VERSION: String

  # Parses a reply that arrived whole into one root, holding the same blocks a stream of it
  # sends to {Listener#on_block}, so a reply looks the same however it came.
  # 
  #   root = StreamingMarkdownParser.parse("Hello.\n\nWorld.\n")
  #   Kramdown::Converter::Html.convert(root).first   # => "<p>Hello.</p>\n<p>World.</p>\n"
  # 
  # A listener takes a whole reply through {#finish} instead: `new(listener).finish(text)`.
  # kramdown's warnings are dropped, as a stream's parses of fragments can't report the same ones.
  # 
  # _@param_ `text`
  # 
  # _@param_ `options` — kramdown options, merged over {DEFAULT_OPTIONS}
  # 
  # _@return_ — the root, {Repair} applied and blank-line elements dropped
  def self.parse: (String text, **::Hash[Symbol, Object] options) -> Kramdown::Element

  # _@param_ `listener` — receives the blocks
  # 
  # _@param_ `options` — kramdown options, merged over {DEFAULT_OPTIONS}
  def initialize: (StreamingMarkdownParser::Listener listener, **::Hash[Symbol, Object] options) -> void

  # Feeds one delta: commits every block it finishes, then re-parses the open tail. A nil or
  # empty delta does nothing.
  # 
  # _@param_ `delta`
  def append: (String? delta) -> void

  # Ends the stream: the open tail becomes blocks, and an empty {Listener#on_open} clears it.
  # 
  # The streamed deltas may not add up to the final text (pikuri's deltas are a preview of its
  # final message). Given a different `authoritative`, the listener gets {Listener#on_reset} and
  # then every block of the authoritative text. With no deltas before, there is nothing to reset:
  # 
  #   StreamingMarkdownParser.new(listener).finish(text)   # a whole reply: its blocks, no reset
  # 
  # _@param_ `authoritative` — the final text, nil for the deltas as they came
  def finish: (?String? authoritative) -> void

  # _@return_ — true after {#finish}
  def finished?: () -> bool

  # _@return_ — the text so far: every delta, or the authoritative text after {#finish}
  def source: () -> String

  # Walks every complete line not yet scanned, committing at each cut kramdown agrees to.
  # 
  # _@return_ — the committed blocks, for {#notify}
  def scan: () -> ::Array[Kramdown::Element]

  # _@param_ `cut` — a line start in @source
  # 
  # _@param_ `line_end` — the end of the line that starts at `cut`
  # 
  # _@return_ — true if kramdown parses the open text before `cut` and the line after it
  # alone into the same blocks as together
  def clean_cut?: (Integer cut, Integer line_end) -> bool

  # Ends the open text at `cut`: the open tail starts there.
  # 
  # _@param_ `cut`
  # 
  # _@return_ — every block of the text before `cut`, each in its own root
  def commit: (Integer cut) -> ::Array[Kramdown::Element]

  # Calls the listener, the last step of {#append} and {#finish}: the parser's state is already
  # final, so a listener that raises leaves nothing half-updated, and no block comes twice.
  # 
  # _@param_ `blocks` — for {Listener#on_block}
  # 
  # _@param_ `open` — for {Listener#on_open}
  # 
  # _@param_ `reset` — true to call {Listener#on_reset} first
  def notify: (::Array[Kramdown::Element] blocks, Kramdown::Element open, ?reset: bool) -> void

  # _@param_ `text`
  # 
  # _@return_ — see {.parse}
  def parse: (String text) -> Kramdown::Element

  # _@param_ `root`
  # 
  # _@return_ — each block as nested arrays, line numbers left out, for comparing
  def shape: (Kramdown::Element root) -> ::Array[::Array[untyped]]

  # _@param_ `element`
  def element_shape: (Kramdown::Element element) -> ::Array[untyped]

  # _@param_ `start` — where an opener line starts in @source
  # 
  # _@param_ `closed` — that opener, closed on the spot
  # 
  # _@return_ — true if kramdown reads an opener at `start`: the open text before it, then
  # `closed`, parse into the blocks of each alone. After a paragraph line, `$$` is inline math.
  def opens?: (Integer start, String closed) -> bool

  # _@param_ `root`
  # 
  # _@return_ — the type of each block
  def types: (Kramdown::Element root) -> ::Array[Symbol]

  # Sets {@closer} if `line` opens a block that only its closer ends, and kramdown agrees.
  # 
  # _@param_ `line`
  # 
  # _@param_ `start` — where `line` starts in @source
  def open_block: (String line, Integer start) -> void

  # Hands `line` to the open block's closer and takes what it answers; see {Closer}.
  # 
  # _@param_ `line`
  # 
  # _@return_ — false if `line` comes after the block, to scan like any other
  def watch: (String line) -> bool

  # _@return_ — the kramdown options every parse runs with; pass them to a
  # converter that needs them
  attr_reader options: ::Hash[Symbol, Object]

  # The blocks that only their closer ends: fences, `$$` math, HTML comments and kramdown's
  # extensions. Until the closer comes, kramdown reads paragraphs, so the parser takes no cut
  # inside one. It holds the open block's closer and hands it each line, getting back the closer
  # for the next:
  # 
  #   closer, rest = Closer.open("$$ a = b\n", 9)   # a Closer::Math; rest is " a = b\n"
  #   closer = closer.watch(rest)                   # itself: still open
  #   closer = closer.watch("c = d $$\n")           # a Closer::MathKept: math if the next line agrees
  #   closer.watch("next\n")                        # Closer::Rewind[to: 9]: kramdown reverts it
  # 
  # `watch` answers itself while the block is open, nil once it closed on that line, {PASS} when
  # the line comes after the block and is scanned like any other, or a {Rewind} when kramdown
  # reverts the block to paragraphs, so a fence inside it counts after all.
  # 
  # Each closer is kramdown's own; one too loose takes a cut that the real closer then undoes.
  module Closer
    PASS: Symbol
    EXTENSION: Regexp
    MATH_KEPT: Regexp

    # _@param_ `line` — a line where a block may start
    # 
    # _@param_ `body` — where the line after it starts in the source
    # 
    # _@return_ — the closer `line` opens, if any, and the rest of `line`
    # after the opener, for that closer's first {#watch}
    def self.open: (String line, Integer body) -> [Object, String]?

    # Ends at a whole line: a fence of the same character, at least as long, or an extension's
    # `{:/name}` or `{:/}`.
    # 
    # @!attribute [r] pattern
    #   @return [Regexp] the closing line
    # @!attribute [r] closed_opener
    #   @return [String, nil] the opener closed on the spot, for kramdown to confirm it opens a
    #     block; nil when no check is needed
    class Line < Data
      # _@param_ `line`
      # 
      # _@return_ — see {Closer}
      def watch: (String line) -> Object?

      # _@return_ — the closing line
      attr_reader pattern: Regexp

      # _@return_ — the opener closed on the spot, for kramdown to confirm it opens a
      # block; nil when no check is needed
      attr_reader closed_opener: String?
    end

    # Ends at the first `-->`, mid-line too. kramdown checks nothing after it.
    # 
    # @!attribute [r] opener
    #   @return [String] `<!--` and the spaces before it
    class Comment < Data
      # _@return_ — see {Line#closed_opener}
      def closed_opener: () -> String

      # _@param_ `line`
      # 
      # _@return_ — see {Closer}
      def watch: (String line) -> Object?

      # _@return_ — `<!--` and the spaces before it
      attr_reader opener: String
    end

    # Ends at the first `$$`, mid-line too; text after it on its line reverts the block.
    # 
    # @!attribute [r] opener
    #   @return [String] `$$` and the spaces before it
    # @!attribute [r] body
    #   @return [Integer] where the line after the opener starts, to rescan from
    class Math < Data
      # _@return_ — see {Line#closed_opener}
      def closed_opener: () -> String

      # _@param_ `line`
      # 
      # _@return_ — see {Closer}
      def watch: (String line) -> Object?

      # _@return_ — `$$` and the spaces before it
      attr_reader opener: String

      # _@return_ — where the line after the opener starts, to rescan from
      attr_reader body: Integer
    end

    # Judges the line after a `$$` block's closer: math only if it is blank, an IAL or `^`.
    # 
    # @!attribute [r] body
    #   @return [Integer] see {Math#body}
    class MathKept < Data
      # _@param_ `line`
      # 
      # _@return_ — see {Closer}
      def watch: (String line) -> Object

      # _@return_ — see {Math#body}
      attr_reader body: Integer
    end

    # kramdown reverted the block: scan again from `to`, with no block open.
    # 
    # @!attribute [r] to
    #   @return [Integer] where in the source to scan from
    class Rewind < Data
      # _@return_ — where in the source to scan from
      attr_reader to: Integer
    end
  end

  # Fixes what LLMs get wrong in Markdown before kramdown parses it. Today one thing: a table
  # separator row written with typographic dashes, which kramdown won't take, so the table falls
  # apart into paragraphs of literal pipes.
  # 
  #   Repair.call("| a | b |\n|—-|—-|\n| 1 | 2 |")   # => "| a | b |\n|--|--|\n| 1 | 2 |"
  # 
  # Only a line made wholly of separator characters with an inner pipe is touched, so prose with
  # an em-dash and a `---` rule stay as they are.
  module Repair
    TABLE_SEPARATOR: Regexp

    # _@param_ `source` — Markdown
    # 
    # _@return_ — the repaired Markdown
    def call: (String source) -> String

    # _@param_ `source` — Markdown
    # 
    # _@return_ — the repaired Markdown
    def self.call: (String source) -> String
  end

  # What a {StreamingMarkdownParser} calls. Include it and override what you use; the rest do
  # nothing. Each call gets a kramdown root, so a converter takes it as is:
  # 
  #   def on_block(root) = @html << Kramdown::Converter::Html.convert(root).first
  # 
  # Calls come on the thread that called {StreamingMarkdownParser#append} or
  # {StreamingMarkdownParser#finish}.
  # 
  # Don't raise. A raise propagates out of that `append` or `finish`, and the calls it still owed
  # are lost, not sent again: the parser goes on, but the listener's copy of the reply has a gap.
  module Listener
    # One finished top-level block, a root with that block as its only child. Final: it is never
    # called back or changed, except by {#on_reset}.
    # 
    # _@param_ `root`
    def on_block: (Kramdown::Element root) -> void

    # The unfinished tail after the last finished block, parsed as it stands: zero or more
    # blocks, provisional. Each call replaces the one before; after the stream ends, it comes
    # empty.
    # 
    # _@param_ `root`
    def on_open: (Kramdown::Element root) -> void

    # The final text differed from the streamed one: forget every block so far, all of them come
    # again.
    def on_reset: () -> void
  end
end